#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define LOWER   1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC &kp TILDE
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBRC &kp RBRC &kp PIPE2 &kp PG_UP
                &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp COLON &kp DQT &kp ENTER &kp PG_DN
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp LT &kp GT &kp QMARK &kp RSHFT &kp UP &kp END
                &kp LCTRL &kp LWIN &kp LALT &kp SPACE &kp RALT &mo 1 &kp RCTRL &kp LEFT &kp DOWN &kp RIGHT
            >;
        };
        lower_layer {
            bindings = <
                &kp LALT &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp BSPC &kp C_MUTE
                &trans &trans &mmv MOVE_UP &trans &trans &trans &trans &trans &trans &trans &bt BT_PRV &trans &trans &trans &kp END
                &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans &trans &trans &trans &trans &trans &trans &kp C_PP &kp HOME
                &trans &trans &trans &bt BT_CLR &trans &trans &bt BT_NXT &trans &trans &trans &trans &trans &kp C_VOL_UP &kp INS
                &bt BT_SEL 0 &trans &bt BT_SEL 1 &bt BT_SEL 2 &trans &trans &trans &kp C_PREV &kp C_VOL_DN &kp C_NEXT
            >;
       };
   };
};
